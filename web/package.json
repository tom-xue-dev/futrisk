{
  "name": "futrisk-web",
  "private": true,
  "version": "0.1.0",
  "description": "futrisk risk-control dashboard: Vue 3 + Vite + TypeScript + Element Plus + ECharts 5 (01 §5.3.5, 02 §9.6-§9.7)",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "dev:live": "vite --mode live",
    "build": "vue-tsc --noEmit && vite build",
    "build:mock": "vue-tsc --noEmit && vite build --mode mock",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "echarts": "^5.6.0",
    "element-plus": "2.14.5",
    "pinia": "^3.0.4",
    "vue": "^3.5.22",
    "vue-echarts": "^7.0.3",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/test-utils": "^2.4.6",
    "happy-dom": "^20.14.5",
    "playwright-core": "^1.63.0",
    "typescript": "~5.9.3",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^6.4.3",
    "vitest": "^3.2.7",
    "vue-tsc": "^2.2.12"
  }
}
